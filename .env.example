# Copy to .env only when using a service manager that loads it; never paste secrets into chat.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Replace with the actual deployed HTTPS origin before starting production.
PUBLIC_BASE_URL=https://your-actual-game-domain.example
# Mount a persistent volume at /data in Docker. Never expose this directory via static hosting.
DATABASE_PATH=/data/math-arena.sqlite
# true only behind one trusted reverse proxy that overwrites/appends the client IP header.
TRUST_PROXY=false
